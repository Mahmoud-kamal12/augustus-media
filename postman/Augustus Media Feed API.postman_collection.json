{
  "info": {
    "_postman_id": "35f0e746-601f-4bb6-8e73-4a2f2e4b5238",
    "name": "Augustus Media Feed API",
    "description": "Postman collection for the Augustus Media Laravel feed API. Import the local environment, run Login Demo to set the bearer token, then exercise feed, follow, post, and like endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: \"Accept\", value: \"application/json\" });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "login_email",
      "value": "demo@example.com",
      "type": "string"
    },
    {
      "key": "login_password",
      "value": "password",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "2",
      "type": "string"
    },
    {
      "key": "post_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "per_page",
      "value": "20",
      "type": "string"
    },
    {
      "key": "cursor",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Demo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "function setVar(key, value) {",
                  "    if (value === undefined || value === null) return;",
                  "    pm.collectionVariables.set(key, String(value));",
                  "    if (pm.environment.name) pm.environment.set(key, String(value));",
                  "}",
                  "setVar(\"token\", json.token);",
                  "setVar(\"current_user_id\", json.user && json.user.id);",
                  "setVar(\"current_user_email\", json.user && json.user.email);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"{{login_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            }
          }
        },
        {
          "name": "Register New User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "function setVar(key, value) {",
                  "    if (value === undefined || value === null) return;",
                  "    pm.collectionVariables.set(key, String(value));",
                  "    if (pm.environment.name) pm.environment.set(key, String(value));",
                  "}",
                  "setVar(\"token\", json.token);",
                  "setVar(\"current_user_id\", json.user && json.user.id);",
                  "setVar(\"current_user_email\", json.user && json.user.email);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"postman-{{$timestamp}}@example.com\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "register"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/user",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "user"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Feed",
      "item": [
        {
          "name": "First Page",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "function setVar(key, value) {",
                  "    if (value === undefined || value === null) return;",
                  "    pm.collectionVariables.set(key, String(value));",
                  "    if (pm.environment.name) pm.environment.set(key, String(value));",
                  "}",
                  "setVar(\"cursor\", json.meta && json.meta.next_cursor);",
                  "if (json.data && json.data.length > 0) setVar(\"post_id\", json.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/feed?per_page={{per_page}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "feed"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "{{per_page}}"
                },
                {
                  "key": "cursor",
                  "value": "{{cursor}}",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Next Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/feed?per_page={{per_page}}&cursor={{cursor}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "feed"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "{{per_page}}"
                },
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Follow",
      "item": [
        {
          "name": "Follow User",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/follow/{{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "follow",
                "{{user_id}}"
              ]
            }
          }
        },
        {
          "name": "Unfollow User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/follow/{{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "follow",
                "{{user_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "function setVar(key, value) {",
                  "    if (value === undefined || value === null) return;",
                  "    pm.collectionVariables.set(key, String(value));",
                  "    if (pm.environment.name) pm.environment.set(key, String(value));",
                  "}",
                  "setVar(\"post_id\", json.data && json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Created from Postman at {{$isoTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/posts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts"
              ]
            }
          }
        },
        {
          "name": "View Post",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts/{{post_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                "{{post_id}}"
              ]
            }
          }
        },
        {
          "name": "Delete Current Post",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts/{{post_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                "{{post_id}}"
              ]
            }
          }
        }
      ]
    },
    {
